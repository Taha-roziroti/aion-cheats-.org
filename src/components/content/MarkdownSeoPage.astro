---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../Breadcrumbs.astro';
import CheckoutDirectPanel from '../checkout/CheckoutDirectPanel.astro';
import type { CheckoutProductId } from '../checkout/CheckoutProductPicker.astro';
import AdditionalCostsCallout from '../checkout/AdditionalCostsCallout.astro';
import { loadContentPage } from '../../utils/loadContentPage';
import { injectAffiliateLinks, checkoutProductForSlug } from '../../utils/affiliateLinks';
import { breadcrumbSchema, webPageSchema } from '../../utils/schema';
import { SITE_NAME } from '../../data/site';

interface Props {
  id: string;
  breadcrumbs: { name: string; path: string }[];
  checkoutProduct?: CheckoutProductId;
  showAdditionalCosts?: boolean;
  noindex?: boolean;
  useProductShell?: boolean;
}

const {
  id,
  breadcrumbs,
  checkoutProduct: checkoutProductProp,
  showAdditionalCosts = false,
  noindex = false,
  useProductShell = true,
} = Astro.props;

const entry = await loadContentPage(id);
const data = entry.data as { title: string; description: string; slug: string };

if (!('slug' in data) || !('title' in data) || !('description' in data)) {
  throw new Error(`MarkdownSeoPage requires ABI marketing frontmatter (title, description, slug): ${id}`);
}

const slug = data.slug.endsWith('/') || data.slug === '/' ? data.slug : `${data.slug}/`;
const checkoutProduct: CheckoutProductId =
  checkoutProductProp ??
  (checkoutProductForSlug(slug) === 'cloudDma'
    ? 'cloud-dma'
    : checkoutProductForSlug(slug) === 'hwidSpoofer'
      ? 'hwid-spoofer'
      : 'main-product');

const patchedEntry = {
  ...entry,
  body: injectAffiliateLinks(entry.body, slug),
};

const { Content } = await render(patchedEntry);
---

<BaseLayout
  title={data.title}
  description={data.description}
  noindex={noindex}
  jsonLd={[
    webPageSchema({ name: data.title, description: data.description, url: slug }),
    breadcrumbSchema(breadcrumbs),
  ]}
  logoAlt={`${data.title} – ${SITE_NAME}`}
>
  {
    useProductShell ? (
      <section class="border-b border-border bg-muted/20 py-10 md:py-14">
        <div class="mx-auto max-w-6xl px-5">
          <Breadcrumbs items={breadcrumbs} class="mb-6 md:mb-8" />
        </div>
        <div class="mx-auto grid max-w-6xl items-start gap-10 px-5 lg:grid-cols-[1fr_minmax(18rem,22rem)]">
          <article class="content-markdown min-w-0 max-w-3xl">
            <Content />
            {showAdditionalCosts ? <AdditionalCostsCallout class="not-prose mt-8" /> : null}
            <div class="not-prose mt-8 lg:hidden">
              <CheckoutDirectPanel product={checkoutProduct} />
            </div>
          </article>
          <div class="hidden lg:block">
            <CheckoutDirectPanel product={checkoutProduct} />
          </div>
        </div>
      </section>
    ) : (
      <article class="border-b border-border bg-muted/20 py-10 md:py-14">
        <div class="mx-auto max-w-6xl px-5">
          <Breadcrumbs items={breadcrumbs} class="mb-6 md:mb-8" />
          <div class="content-markdown mt-2 max-w-3xl">
            <Content />
          </div>
        </div>
      </article>
    )
  }
</BaseLayout>

<style is:global>
  .content-markdown :where(h1) {
    font-size: clamp(1.875rem, 4vw, 2.5rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.12;
    margin-bottom: 1rem;
    color: var(--foreground);
  }
  .content-markdown :where(h2) {
    font-size: 1.375rem;
    font-weight: 700;
    margin-top: 2.5rem;
    margin-bottom: 0.75rem;
    scroll-margin-top: 7rem;
    color: var(--foreground);
  }
  .content-markdown :where(h3) {
    font-size: 1.125rem;
    font-weight: 600;
    margin-top: 1.5rem;
    margin-bottom: 0.5rem;
    color: var(--foreground);
  }
  .content-markdown :where(p, ul, ol) {
    color: var(--muted-foreground);
    line-height: 1.7;
    margin-top: 0.75rem;
  }
  .content-markdown :where(ul, ol) {
    padding-left: 1.25rem;
  }
  .content-markdown :where(ul) {
    list-style: disc;
  }
  .content-markdown :where(ol) {
    list-style: decimal;
  }
  .content-markdown :where(li + li) {
    margin-top: 0.35rem;
  }
  .content-markdown :where(a:not([data-slot='button'])) {
    color: var(--primary);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .content-markdown :where(strong) {
    color: var(--foreground);
    font-weight: 600;
  }
  .content-markdown :where(table) {
    width: 100%;
    border-collapse: collapse;
    margin-top: 1rem;
    font-size: 0.875rem;
  }
  .content-markdown :where(th, td) {
    border: 1px solid var(--border);
    padding: 0.5rem 0.75rem;
    text-align: left;
  }
  .content-markdown :where(th) {
    background: color-mix(in oklab, var(--muted) 50%, transparent);
    color: var(--foreground);
    font-weight: 600;
  }
</style>
