---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../Breadcrumbs.astro';
import CheckoutDirectPanel from '../checkout/CheckoutDirectPanel.astro';
import type { CheckoutProductId } from '../checkout/CheckoutProductPicker.astro';
import AdditionalCostsCallout from '../checkout/AdditionalCostsCallout.astro';
import SiteFaqSection from '../SiteFaqSection.astro';
import { Button } from '@/components/starwind/button';
import type { AbiPage } from '../../data/abi/types';
import { normalizeAbiParagraph, resolveAbiHref } from '../../utils/abiText';
import { abiFaqsToSiteItems } from '../../utils/abiFaqs';
import { breadcrumbSchema, webPageSchema } from '../../utils/schema';
import { SITE_NAME } from '../../data/site';

interface Props {
  page: AbiPage;
  breadcrumbs: { name: string; path: string }[];
  checkoutProduct?: CheckoutProductId;
  showAdditionalCosts?: boolean;
  noindex?: boolean;
}

const {
  page,
  breadcrumbs,
  checkoutProduct = 'main-product',
  showAdditionalCosts = false,
  noindex = false,
} = Astro.props;

const faqItems = abiFaqsToSiteItems(
  page.faqs,
  page.slug.includes('pricing') ? 'plans' : 'esp',
);
const ctaHref = resolveAbiHref(page.cta.href);
---

<BaseLayout
  title={page.seo.title}
  description={page.seo.description}
  noindex={noindex}
  jsonLd={[
    webPageSchema({ name: page.seo.title, description: page.seo.description, url: page.slug }),
    breadcrumbSchema(breadcrumbs),
  ]}
  logoAlt={`${page.h1} – ${SITE_NAME}`}
>
  {page.draftOnly ? (
    <p class="border-b border-amber-500/40 bg-amber-500/10 px-5 py-3 text-center text-sm text-amber-200">
      Draft — {page.publishNote ?? 'Not published for indexing yet.'}
    </p>
  ) : null}

  <section class="border-b border-border bg-muted/20 py-10 md:py-14">
    <div class="mx-auto max-w-6xl px-5">
      <Breadcrumbs items={breadcrumbs} class="mb-6 md:mb-8" />
    </div>
    <div
      class:list={[
        'mx-auto grid max-w-6xl items-start gap-10 px-5',
        checkoutProduct ? 'lg:grid-cols-[1fr_minmax(18rem,22rem)]' : '',
      ]}
    >
      <article class="abi-content min-w-0 max-w-3xl">
        <h1>{page.h1}</h1>
        <p>{normalizeAbiParagraph(page.introduction)}</p>

        {
          page.sections.map((section) => (
            <section>
              <h2>{section.heading}</h2>
              {section.paragraphs.map((p) => (
                <p>{normalizeAbiParagraph(p)}</p>
              ))}
              {section.bullets?.length ? (
                <ul>
                  {section.bullets.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
              ) : null}
              {section.plans?.length ? (
                <div class="not-prose my-6 grid gap-4 sm:grid-cols-2">
                  {section.plans.map((plan) => (
                    <div class="rounded-xl border border-border bg-card p-4">
                      <p class="text-lg font-semibold text-foreground">{plan.name}</p>
                      <p class="text-2xl font-bold tabular-nums text-primary">{plan.price}</p>
                      <p class="text-sm text-muted-foreground">{plan.duration}</p>
                      <p class="mt-2 text-sm text-muted-foreground">{plan.description}</p>
                    </div>
                  ))}
                </div>
              ) : null}
            </section>
          ))
        }

        {showAdditionalCosts ? <AdditionalCostsCallout class="not-prose mt-8" /> : null}

        {page.internalLinks.length ? (
          <nav class="not-prose mt-10 rounded-xl border border-border bg-muted/20 p-4" aria-label="Related pages">
            <p class="text-sm font-semibold text-foreground">Related pages</p>
            <ul class="mt-2 space-y-1 text-sm">
              {page.internalLinks.map((link) => (
                <li>
                  <a class="text-primary underline underline-offset-2" href={resolveAbiHref(link.href)}>
                    {link.text}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        ) : null}

        <div class="not-prose mt-8 lg:hidden">
          {checkoutProduct ? <CheckoutDirectPanel product={checkoutProduct} /> : null}
        </div>
      </article>

      {checkoutProduct ? (
        <div class="hidden lg:block">
          <CheckoutDirectPanel product={checkoutProduct} />
        </div>
      ) : null}
    </div>
  </section>

  <SiteFaqSection
    id="page-faq"
    titleId="page-faq-title"
    titleAs="h2"
    items={faqItems}
    showFilters={false}
    class="border-t border-border"
  />

  <div class="border-t border-border bg-muted/20 py-10 md:py-12">
    <div class="mx-auto flex max-w-6xl flex-col items-start gap-4 px-5">
      <h2 class="text-lg font-semibold text-foreground">{page.cta.heading}</h2>
      <p class="max-w-2xl text-muted-foreground">{page.cta.text}</p>
      <Button as="a" href={ctaHref} variant="primary" size="lg" class="rounded-xl">
        {page.cta.button}
      </Button>
    </div>
  </div>
</BaseLayout>

<style is:global>
  .abi-content :where(h1) {
    font-size: clamp(1.875rem, 4vw, 2.5rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.12;
    margin-bottom: 1rem;
    color: var(--foreground);
  }
  .abi-content :where(h2) {
    font-size: 1.375rem;
    font-weight: 700;
    margin-top: 2.5rem;
    margin-bottom: 0.75rem;
    scroll-margin-top: 7rem;
    color: var(--foreground);
  }
  .abi-content :where(p, ul) {
    color: var(--muted-foreground);
    line-height: 1.7;
    margin-top: 0.75rem;
  }
  .abi-content :where(ul) {
    list-style: disc;
    padding-left: 1.25rem;
  }
  .abi-content :where(li + li) {
    margin-top: 0.35rem;
  }
  .abi-content :where(a) {
    color: var(--primary);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
</style>
