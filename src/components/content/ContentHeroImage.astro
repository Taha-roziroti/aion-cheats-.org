---
import {
  defaultWebpSrc,
  HERO_IMAGE_SIZES,
  HERO_IMAGE_WIDTHS,
  responsiveSrcSet,
} from '../../utils/responsiveImage';

interface Props {
  src: string;
  alt: string;
  priority?: boolean;
  class?: string;
}

const { src, alt, priority = false, class: className = '' } = Astro.props;
const isSvg = src.toLowerCase().endsWith('.svg');
const srcSet = isSvg ? undefined : responsiveSrcSet(src, HERO_IMAGE_WIDTHS);
const imgSrc = isSvg ? src : defaultWebpSrc(src, HERO_IMAGE_WIDTHS);
---

<figure class={`overflow-hidden rounded-2xl border border-border bg-muted/20 ${className}`}>
  <img
    src={imgSrc}
    srcset={srcSet}
    sizes={isSvg ? undefined : '(min-width: 1024px) min(42rem, 50vw), 100vw'}
    alt={alt}
    width={960}
    height={540}
    loading={priority ? 'eager' : 'lazy'}
    decoding={priority ? 'sync' : 'async'}
    fetchpriority={priority ? 'high' : 'auto'}
    class="aspect-video w-full object-cover"
  />
  <figcaption class="border-t border-border px-4 py-2 text-xs text-muted-foreground">{alt}</figcaption>
</figure>
