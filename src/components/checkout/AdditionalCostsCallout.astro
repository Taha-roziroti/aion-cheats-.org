---
interface Props {
  class?: string;
  pricingLinkLabel?: string;
  setupLinkLabel?: string;
}

const {
  class: className = '',
  pricingLinkLabel = 'ESP & aimbot plan costs',
  setupLinkLabel = 'Hyper-V setup walkthrough',
} = Astro.props;
---

<aside
  class={`rounded-2xl border border-amber-500/40 bg-amber-500/10 p-5 text-sm text-foreground ${className}`}
  aria-labelledby="cloud-dma-additional-costs"
>
  <h2 id="cloud-dma-additional-costs" class="text-base font-semibold text-foreground">
    Cloud DMA license is not the full setup cost
  </h2>
  <p class="mt-2 text-muted-foreground">
    The listed Cloud DMA price ($50 lifetime at publish time) covers the infrastructure license only. You must also
    purchase and maintain these separate services before activation:
  </p>
  <ul class="mt-3 list-disc space-y-2 pl-5 text-muted-foreground">
    <li>
      <strong class="text-foreground">GREENWARD</strong> — required activation and routing service (bought outside this
      site).
    </li>
    <li>
      <strong class="text-foreground">Static Server</strong> — dedicated server component with its own fee.
    </li>
    <li>
      <strong class="text-foreground">AWS</strong> — cloud resources with separate billing; not included in the $50
      license.
    </li>
  </ul>
  <p class="mt-3 text-muted-foreground">
    Budget for all three in addition to the license before checkout. See
    <a class="text-primary underline-offset-2 hover:underline" href="/aion-classic-pricing/">{pricingLinkLabel}</a> and
    <a class="text-primary underline-offset-2 hover:underline" href="/guides/cloud-dma-setup/">{setupLinkLabel}</a> for
    context.
  </p>
</aside>