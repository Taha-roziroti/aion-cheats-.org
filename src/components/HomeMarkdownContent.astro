---
import { render } from 'astro:content';
import { loadContentPage } from '../utils/loadContentPage';
import { injectAffiliateLinks } from '../utils/affiliateLinks';

const entry = await loadContentPage('home');
const data = entry.data as { slug: string };
const slug = data.slug.endsWith('/') ? data.slug : `${data.slug}/`;
const patchedEntry = {
  ...entry,
  body: injectAffiliateLinks(entry.body, slug),
};
const { Content } = await render(patchedEntry);
---

<section class="border-t border-border bg-background py-12 md:py-16" id="abi-overview">
  <div class="content-markdown mx-auto max-w-3xl px-5">
    <Content />
  </div>
</section>

<style is:global>
  #abi-overview .content-markdown :where(h1) {
    font-size: clamp(1.875rem, 4vw, 2.5rem);
    font-weight: 700;
    margin-bottom: 1rem;
    color: var(--foreground);
  }
  #abi-overview .content-markdown :where(h2, h3) {
    font-weight: 700;
    margin-top: 2rem;
    margin-bottom: 0.75rem;
    color: var(--foreground);
  }
  #abi-overview .content-markdown :where(p, ul, ol) {
    color: var(--muted-foreground);
    line-height: 1.7;
    margin-top: 0.75rem;
  }
  #abi-overview .content-markdown :where(ul) {
    list-style: disc;
    padding-left: 1.25rem;
  }
  #abi-overview .content-markdown :where(table) {
    width: 100%;
    border-collapse: collapse;
    margin-top: 1rem;
    font-size: 0.875rem;
  }
  #abi-overview .content-markdown :where(th, td) {
    border: 1px solid var(--border);
    padding: 0.5rem 0.75rem;
  }
  #abi-overview .content-markdown :where(a) {
    color: var(--primary);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
</style>
