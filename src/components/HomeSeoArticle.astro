---
import { abiPages } from '../data/abi';
import { normalizeAbiParagraph, resolveAbiHref } from '../utils/abiText';
import { Button } from '@/components/starwind/button';

const { home } = abiPages;
const ctaHref = resolveAbiHref(home.cta.href);
---

<section class="border-t border-border bg-background py-12 md:py-16" id="abi-overview">
  <div class="abi-content mx-auto max-w-3xl px-5">
    <p class="text-lg leading-relaxed text-muted-foreground">{normalizeAbiParagraph(home.introduction)}</p>

    {
      home.sections.map((section) => (
        <section>
          <h2>{section.heading}</h2>
          {section.paragraphs.map((p) => (
            <p>{normalizeAbiParagraph(p)}</p>
          ))}
          {section.bullets?.length ? (
            <ul>
              {section.bullets.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          ) : null}
        </section>
      ))
    }

  {home.internalLinks.length ? (
    <nav class="not-prose mt-8 rounded-xl border border-border bg-muted/20 p-4" aria-label="Explore ABI topics">
      <p class="text-sm font-semibold text-foreground">Explore further</p>
      <ul class="mt-2 space-y-1 text-sm">
        {home.internalLinks.map((link) => (
          <li>
            <a class="text-primary underline underline-offset-2" href={resolveAbiHref(link.href)}>
              {link.text}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  ) : null}
  </div>

  <div class="mx-auto mt-10 max-w-3xl px-5">
    <div class="rounded-xl border border-border bg-muted/20 p-6">
      <h2 class="text-lg font-semibold text-foreground">{home.cta.heading}</h2>
      <p class="mt-2 text-muted-foreground">{home.cta.text}</p>
      <Button as="a" href={ctaHref} variant="primary" size="lg" class="mt-4 rounded-xl">
        {home.cta.button}
      </Button>
    </div>
  </div>
</section>

<style is:global>
  #abi-overview .abi-content :where(h2) {
    font-size: 1.375rem;
    font-weight: 700;
    margin-top: 2.5rem;
    margin-bottom: 0.75rem;
    color: var(--foreground);
  }
  #abi-overview .abi-content :where(p, ul) {
    color: var(--muted-foreground);
    line-height: 1.7;
    margin-top: 0.75rem;
  }
  #abi-overview .abi-content :where(ul) {
    list-style: disc;
    padding-left: 1.25rem;
  }
</style>
