---
import BaseLayout from '../layouts/BaseLayout.astro';
import { t } from '../i18n';
import { resolvePageSeo } from '../config/seo';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import ContactSupportSection from '../components/ContactSupportSection.astro';
import { breadcrumbSchema, webPageSchema } from '../utils/schema';

const seo = resolvePageSeo('/support/');
const breadcrumbs = [
  { name: 'Home', path: '/' },
  { name: 'Support', path: '/support/' },
];
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  logoAlt="Support – site logo"
  jsonLd={[
    webPageSchema({
      name: t.support.title,
      description: t.support.subtitle,
      url: '/support/',
    }),
    breadcrumbSchema(breadcrumbs),
  ]}
>
  <section class="border-b border-border bg-muted/20 py-8 md:py-10">
    <div class="mx-auto max-w-6xl px-5">
      <Breadcrumbs items={breadcrumbs} />
    </div>
  </section>

  <ContactSupportSection titleId="support-page-title" showTicketTips />

  <article class="content-markdown border-t border-border bg-muted/10 py-10 md:py-12">
    <div class="mx-auto max-w-3xl px-5">
      <h2 class="text-lg font-semibold text-foreground">Before you contact support</h2>
      <p>
        Confirm the listed offers match your order: main Dota 2 cheat plans, plus optional Cloud DMA and HWID utilities on separate checkouts. Support cannot change vendor pricing, but we can help you find the right receipt and escalation path.
      </p>
      <p>
        Common answers live in the <a href="/faq/">pre-purchase question list</a>, including Windows version questions, plan length, and what the feature list labels mean on the current build.
      </p>
      <h2>Information to include in every ticket</h2>
      <p>
        Paste your order email, the product name you bought, and your Windows build number from Settings. For loader issues, attach the exact error text—screenshots help when Hyper-V or antivirus blocks execution.
      </p>
      <p>
        If you followed the <a href="/guides/system-requirements/">hardware checklist guide</a> or the <a href="/guides/cloud-dma-setup/">Hyper-V walkthrough</a> steps, note which step failed so we do not ask you to repeat finished work.
      </p>
      <h2>Response expectations</h2>
      <p>
        We reply during United States business hours when possible. Vendor-side license delivery may take additional time on weekends; check spam folders for automated messages before opening a duplicate ticket.
      </p>
      <p>
        Refund and chargeback decisions stay with the checkout partner listed on your receipt. We help you reach that channel with complete details but cannot override their policy.
      </p>
      <h2>Feature and pricing questions</h2>
      <p>
        For “what is included” questions, start with the <a href="/dota-2-cheats-review/">independent cheats write-up</a> and module pages such as the <a href="/dota-2-maphack/">fog-of-war maphack page</a> or the <a href="/dota-2-hero-esp/">player overlay guide</a>. Those guides describe features and pricing summaries that should match checkout when you buy through the <a href="/go/">Zadeyo checkout bridge</a>.
      </p>
    </div>
  </article>
</BaseLayout>
