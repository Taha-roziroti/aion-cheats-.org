---
import BaseLayout from '../layouts/BaseLayout.astro';
import { t } from '../i18n';
import { resolvePageSeo } from '../config/seo';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import ContactSupportSection from '../components/ContactSupportSection.astro';
import { breadcrumbSchema, webPageSchema } from '../utils/schema';

const seo = resolvePageSeo('/support/');
const breadcrumbs = [
  { name: 'Home', path: '/' },
  { name: 'Support', path: '/support/' },
];
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  logoAlt="Support – site logo"
  jsonLd={[
    webPageSchema({
      name: t.support.title,
      description: t.support.subtitle,
      url: '/support/',
    }),
    breadcrumbSchema(breadcrumbs),
  ]}
>
  <section class="border-b border-border bg-muted/20 py-8 md:py-10">
    <div class="mx-auto max-w-6xl px-5">
      <Breadcrumbs items={breadcrumbs} />
    </div>
  </section>

  <ContactSupportSection titleId="support-page-title" showTicketTips />

  <article class="content-markdown border-t border-border bg-muted/10 py-10 md:py-12">
    <div class="mx-auto max-w-3xl px-5">
      <h2 class="text-lg font-semibold text-foreground">Before you contact support</h2>
      <p>
        Support body copy placeholder. Describe what visitors should verify before opening a ticket, which
        products use separate checkout flows, and where self-serve answers live.
      </p>
      <p>
        Link visitors to the <a href="/faq/">FAQ template</a> for common pre-purchase questions and to feature
        guides such as the <a href="/dota-2-maphack/">first feature template</a> when modules need context.
      </p>
      <h2>Information to include in every ticket</h2>
      <p>
        Ticket checklist placeholder — order email, product name, OS build, and error text. Replace with fields your
        vendor or internal team requires.
      </p>
      <p>
        Reference guides like the <a href="/guides/system-requirements/">requirements template</a> or
        <a href="/guides/cloud-dma-setup/">setup template</a> when troubleshooting install steps.
      </p>
      <h2>Response expectations</h2>
      <p>
        Response-time placeholder. Document business hours, weekend delays, and spam-folder reminders for license email.
      </p>
      <p>
        Refund placeholder — clarify that payment disputes stay with the checkout partner on the customer receipt.
      </p>
      <h2>Feature and pricing questions</h2>
      <p>
        Point buyers to the <a href="/dota-2-cheats-review/">review template</a> and module pages for feature lists.
        Checkout runs through the <a href="/go/">checkout hub placeholder</a> once affiliate URLs are configured.
      </p>
    </div>
  </article>
</BaseLayout>