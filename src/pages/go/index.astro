---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CheckoutProductChooser from '../../components/checkout/CheckoutProductChooser.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { resolvePageSeo } from '../../config/seo';

const seo = resolvePageSeo('/go/');
---

<BaseLayout
  title={seo.title}
  description={seo.description}
>
  <article class="py-10 md:py-14">
    <div class="mx-auto max-w-3xl px-5">
      <Breadcrumbs
        items={[
          { name: 'Home', path: '/' },
          { name: 'Checkout', path: '/go/' },
        ]}
      />
      <header class="mt-6">
        <h1 class="text-3xl font-semibold tracking-tight text-foreground md:text-4xl">Choose a product</h1>
        <p class="mt-3 text-muted-foreground">
          Select what you want to purchase. You will be sent to our partner checkout in one step.
        </p>
      </header>
      <div class="mt-8">
        <CheckoutProductChooser />
      </div>
    </div>
  </article>
</BaseLayout>
