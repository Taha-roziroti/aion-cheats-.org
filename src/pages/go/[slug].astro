---
import { CHECKOUT_BRIDGE_SLUGS, checkoutDestinationForSlug } from '../../config/checkout-redirects.mjs';

export function getStaticPaths() {
  return CHECKOUT_BRIDGE_SLUGS.map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const destination = checkoutDestinationForSlug(slug ?? '');

if (!destination) {
  return Astro.redirect('/go/');
}
---

<!doctype html>
<html lang="en-US">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Continuing to checkout…</title>
    <meta http-equiv="refresh" content={`0;url=${destination}`} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site).href} />
    <script is:inline define:vars={{ destination }}>
      window.location.replace(destination);
    </script>
    <style>
      html,
      body {
        margin: 0;
        min-height: 100%;
        background: #0d0a14;
        color: #e8e4ef;
        font-family: system-ui, sans-serif;
      }
      .wrap {
        display: flex;
        min-height: 100vh;
        align-items: center;
        justify-content: center;
        padding: 1.5rem;
      }
      p {
        margin: 0;
        font-size: 0.875rem;
        opacity: 0.85;
      }
    </style>
  </head>
  <body>
    <div class="wrap">
      <p>Opening checkout…</p>
    </div>
  </body>
</html>
