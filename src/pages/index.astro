---
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeLanding from '../components/HomeLanding.astro';
import { loadContentPage } from '../utils/loadContentPage';
import { jsonLdForContentPage } from '../utils/contentPageJsonLd';
import { MAIN_PRODUCT_CHECKOUT } from '../data/productCatalog';
import { PRODUCT_ID } from '../data/site';
import { productSchema } from '../utils/schema';
import { HERO_SECTION_LCP_PRELOAD } from '../data/showcaseImages';

const homeEntry = await loadContentPage('home');
const home = homeEntry.data as { title: string; description: string; slug: string };

const jsonLd = [
  productSchema({
    name: 'Arena Breakout Infinite Cheats',
    description: home.description,
    url: '/',
    offerUrl: MAIN_PRODUCT_CHECKOUT,
    sku: 'arena-breakout-infinite-cheats',
    image: '/images/showcase/abi-esp-indoor-aimbot.webp',
    productId: PRODUCT_ID,
    offers: [
      { name: 'Arena Breakout Infinite — Monthly', priceUsd: 35, url: MAIN_PRODUCT_CHECKOUT },
      { name: 'Arena Breakout Infinite — Lifetime', priceUsd: 150, url: MAIN_PRODUCT_CHECKOUT },
    ],
  }),
  ...jsonLdForContentPage({
    route: '/',
    seoTitle: home.title,
    metaDescription: home.description,
    schemaTypes: ['BreadcrumbList'],
  }),
];
---

<BaseLayout
  title={home.title}
  description={home.description}
  jsonLd={jsonLd}
  ogImage="/og/home.jpg"
  ogImageAlt="Arena Breakout Infinite Cheats"
  logoAlt="Arena Breakout Infinite Cheats – logo"
>
  <link
    slot="head"
    rel="preload"
    as="image"
    href={HERO_SECTION_LCP_PRELOAD}
    type="image/webp"
    fetchpriority="high"
  />
  <HomeLanding />
</BaseLayout>
