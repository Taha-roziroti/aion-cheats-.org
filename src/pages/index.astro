---
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeLanding from '../components/HomeLanding.astro';
import { loadContentPage } from '../utils/loadContentPage';
import { jsonLdForContentPage } from '../utils/contentPageJsonLd';
import { MAIN_PRODUCT_CHECKOUT, mainProductOffers } from '../data/productCatalog';
import { PRODUCT_ID, ogImageForPath } from '../data/site';
import { PLACEHOLDER_COPY } from '../data/placeholders';
import { PRIMARY_SHOWCASE_IMAGE } from '../data/showcaseImages';
import { faqPageSchemaFromPairs, productSchema } from '../utils/schema';
import { faqItemsFromMarkdown } from '../utils/markdownFaq';
import { HERO_SECTION_LCP_PRELOAD } from '../data/showcaseImages';

const homeEntry = await loadContentPage('index');
const home = homeEntry.data as { title: string; description: string; slug: string };
const homeFaqs = faqItemsFromMarkdown(homeEntry.body);

const jsonLd = [
  productSchema({
    name: PLACEHOLDER_COPY.productName,
    description: home.description,
    url: '/',
    offerUrl: MAIN_PRODUCT_CHECKOUT,
    sku: 'main-product',
    image: PRIMARY_SHOWCASE_IMAGE,
    productId: PRODUCT_ID,
    offers: mainProductOffers.map((o) => ({
      name: o.name,
      priceUsd: o.priceUsd,
      url: o.url,
    })),
  }),
  ...jsonLdForContentPage({
    route: '/',
    seoTitle: home.title,
    metaDescription: home.description,
    schemaTypes: ['BreadcrumbList'],
  }),
  ...(homeFaqs.length >= 2 ? [faqPageSchemaFromPairs(homeFaqs)] : []),
];
---

<BaseLayout
  title={home.title}
  description={home.description}
  jsonLd={jsonLd}
  ogImage={ogImageForPath('/')}
  ogImageAlt={PLACEHOLDER_COPY.title}
  logoAlt={`${PLACEHOLDER_COPY.title} – logo`}
>
  <link
    slot="head"
    rel="preload"
    as="image"
    href={HERO_SECTION_LCP_PRELOAD}
    type="image/webp"
    fetchpriority="high"
  />
  <HomeLanding />
</BaseLayout>
